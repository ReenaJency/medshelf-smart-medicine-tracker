# ==============================================================================
# MEDSHELF: Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret Key for Session Tokens (use a strong random string)
JWT_SECRET=medshelf_super_secret_jwt_key_2026_change_in_production

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=medshelf_db
DB_PORT=3306

# Note: If MySQL credentials are not set or MySQL is unreachable,
# MedShelf will automatically fall back to its internal persistent database
# located at database/medshelf.db, ensuring 100% uptime for local testing!
